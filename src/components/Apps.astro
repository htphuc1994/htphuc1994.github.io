---
import { profile, playStore, appStore, appStoreDownloads } from "../data/cv";

const groups = [
  { label: "Google Play", items: playStore },
  { label: "App Store", items: appStore },
];
---

<section class="section" id="apps">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="index">05 / Builds</span>
        <h2>Games &amp; Apps</h2>
        <p class="section-sub">{appStoreDownloads} downloads on the App Store</p>
      </div>
    </div>
    {groups.map((g) => (
      <>
        <h3 class="group-label">{g.label} <span class="group-count">{g.items.length}</span></h3>
        {g.items.map((a) => (
          <div class="entry">
            <div class="meta">{g.label}</div>
            <div>
              <div class="sub">
                <a href={a.url} target="_blank" rel="noopener">{a.name}</a>
              </div>
            </div>
          </div>
        ))}
      </>
    ))}
    <p class="see-all">
      <a href={profile.appStore} target="_blank" rel="noopener">See all apps on the App Store →</a>
    </p>
  </div>
</section>
